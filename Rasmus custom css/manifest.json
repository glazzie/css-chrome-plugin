{
  "manifest_version": 3,
  "name": "Rasmus Custom CSS",
  "version": "1.0",
  "description": "Ladda ner dåligt, bygga bra?",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}